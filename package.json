{
  "name": "@frillab/copc-tiles-validate",
  "version": "0.1.0",
  "description": "Dependency-free structural validation for local 3D Tiles 1.0 and 1.1 assets",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "copc-tiles-validate": "./src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/cli.js && node --check src/validator.js && node --check src/formats.js",
    "verify": "npm run check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrilLab/copc-tiles-validate.git"
  },
  "homepage": "https://github.com/FrilLab/copc-tiles-validate#readme",
  "bugs": {
    "url": "https://github.com/FrilLab/copc-tiles-validate/issues"
  },
  "types": "./src/index.d.ts"
}
